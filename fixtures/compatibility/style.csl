<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" version="1.0" class="in-text" default-locale="en-US">
  <info>
    <title>Markroot fixture author-date</title>
    <id>https://markroot.local/styles/fixture-author-date</id>
    <updated>2026-09-04T00:00:00+00:00</updated>
  </info>
  <citation>
    <layout prefix="(" suffix=")" delimiter="; ">
      <text variable="author" form="short"/>
      <date variable="issued" prefix=" "><date-part name="year"/></date>
    </layout>
  </citation>
  <bibliography>
    <layout suffix=".">
      <text variable="author" suffix=". "/>
      <date variable="issued" suffix=". "><date-part name="year"/></date>
      <text variable="title" font-style="italic"/>
    </layout>
  </bibliography>
</style>
