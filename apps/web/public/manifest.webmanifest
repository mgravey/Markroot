{
  "name": "Markroot",
  "short_name": "Markroot",
  "description": "A private, browser-only Markdown and QMD workspace.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#edf0ee",
  "theme_color": "#006f62",
  "icons": [
    { "src": "./brand/markroot-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "./brand/markroot-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "./brand/markroot-mark.svg", "sizes": "any", "type": "image/svg+xml" }
  ]
}
